{
  "name": "xpath-go-tests",
  "version": "1.7.1",
  "private": true,
  "description": "XPath Go library compatibility tests with jsdom",
  "main": "comprehensive_compare.js",
  "scripts": {
    "test": "node comprehensive_compare.js",
    "test:runner-unit": "node --test runner_architecture_test.js",
    "test:compatibility": "node comprehensive_compare.js",
    "test:typed-conversions": "node typed_conversions_test.js",
    "test:charset": "node charset_oracle_test.js",
    "test:edge-cases": "node edge_cases_test.js",
    "test:quick": "npm run test:runner-unit && npm run test:typed-conversions && npm run test:charset && npm run test:edge-cases",
    "test:all": "npm run test:quick && npm run test:compatibility",
    "install-deps": "npm install"
  },
  "dependencies": {
    "jsdom": "^23.0.0",
    "whatwg-encoding": "^3.1.1"
  },
  "devDependencies": {},
  "keywords": ["xpath", "jsdom", "compatibility", "testing"],
  "author": "Reclaim Protocol",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
